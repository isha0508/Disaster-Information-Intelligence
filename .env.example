# Public USGS GeoJSON feed (no credentials required).
USGS_ENABLED=true
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson

# GDACS public Events search API (no credentials required).
GDACS_ENABLED=true
GDACS_FEED_URL=https://www.gdacs.org/gdacsapi/api/Events/geteventlist/SEARCH
GDACS_EVENT_TYPES=EQ,TC,FL,VO,DR,WF
GDACS_DAYS=7

# Configurable RSS/Atom sources. The official GDACS public RSS alert feed is
# the default; set this blank to disable or add permitted feeds comma-separated.
NEWS_ENABLED=true
DISASTER_RSS_FEEDS=https://www.gdacs.org/xml/rss.xml
DISASTER_RSS_FILTER_ENABLED=true
DISASTER_RSS_KEEP_UNCERTAIN=true
DISASTER_RSS_KEYWORDS=earthquake,flood,cyclone,hurricane,storm,landslide,wildfire,tsunami,volcano,drought,disaster,evacuation,rescue,emergency

# Public Mastodon hashtag timelines (no credentials required).
DISASTER_MASTODON_ENABLED=true
DISASTER_MASTODON_BASE_URL=https://mastodon.social
DISASTER_MASTODON_HASHTAGS=earthquake,flood,wildfire,hurricane
DISASTER_MASTODON_LIMIT=10

# Network/poll settings. Public sources are polled no faster than once/minute;
# 360 seconds matches the GDACS feed's published update cadence.
DISASTER_SOURCE_TIMEOUT=20
DISASTER_POLL_INTERVAL=360
DISASTER_MAX_EVENTS_PER_SOURCE=10
DISASTER_SOURCE_RETRY_COUNT=2
DISASTER_SOURCE_RETRY_BACKOFF=1
DISASTER_MONITORING_LOG_LEVEL=INFO
DISASTER_STALE_RUN_SECONDS=1800
DISASTER_SOURCE_USER_AGENT=DisasterInformationIntelligence/1.0

# Phase 6 place lookup: async, cached Nominatim lookups are enabled by default.
# Set provider to "offline" to use only vetted local gazetteer entries.
# Public Nominatim is limited to <=4 requests/minute by the single-worker gate.
DISASTER_GEOCODER_PROVIDER=nominatim
DISASTER_GEOCODER_URL=https://nominatim.openstreetmap.org/search
DISASTER_GEOCODER_USER_AGENT=DisasterInformationIntelligence/1.0
DISASTER_GEOCODER_TIMEOUT=5
DISASTER_GEOCODER_MIN_INTERVAL=15
DISASTER_GEOCODER_GAZETTEER_PATH=

# Local Phase 11 SQLite API settings. DISASTER_DB_PATH may be set locally to
# override the ignored default data/database/disaster_intelligence.db path.
DISASTER_DB_PATH=data/database/disaster_intelligence.db
API_HOST=127.0.0.1
API_PORT=8770
API_LOG_LEVEL=INFO

# Phase 11.5 API-backed local operations dashboard.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_API_BASE_URL=http://127.0.0.1:8770
DASHBOARD_API_TIMEOUT=3

# Optional Phase 7 provider settings. The current monitoring pipeline explicitly
# uses its grounded mock provider; these values do not switch monitoring to a
# remote provider. Never put provider credentials in this example file.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_MAX_CONTEXT_CHARS=12000
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=800
LLM_GROUNDING_ENABLED=true
LLM_RECOMMENDATIONS_ENABLED=true
LLM_SPATIAL_CONTEXT_ENABLED=true
# Optional only for direct Phase 7 provider use; keep empty unless configured locally.
LLM_API_BASE_URL=
# LLM_API_KEY=<set locally; do not commit>
LLM_TIMEOUT_SECONDS=20
